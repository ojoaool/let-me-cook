            Icon = Data.Icon or "rbxassetid://108020878442937",
            Columns = Data.Columns or 2,
            OldTab = {},
            Items = {},
            Pages = {},
            Tweening = false,
            Window = self,
            Buttons = self.Items.TabButtonHolder,
            SectionData = self.Sections,
